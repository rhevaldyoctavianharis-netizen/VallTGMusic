{
  "name": "VallTgMusic New",
  "description": "Bot musik Telegram untuk Voice Chat (Telethon + PyTgCalls).",
  "repository": "https://github.com/rhevaldyoctavianharis-netizen/VallTGMusic",
  "website": "https://rhevaldy.my.id",
  "keywords": ["telegram", "music-bot", "telethon", "pytgcalls"],
  "stack": "heroku-24",
  "buildpacks": [
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest" },
    { "url": "heroku/nodejs" },
    { "url": "heroku/python" }
  ],
  "formation": {
    "worker": { "quantity": 1, "size": "basic" }
  },
  "env": {
    "API_ID": {
      "description": "API ID dari https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "API Hash dari https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Token bot dari @BotFather",
      "required": true
    },
    "SESSION_STRING": {
      "description": "String session akun userbot. Dapatkan dari @ssgenduabot",
      "required": true
    },
    "ADMIN_ID": {
      "description": "ID Telegram Anda (owner bot)",
      "required": true
    },
    "CREDIT_CHANNEL": {
      "description": "Link channel kredit (opsional)",
      "value": "https://t.me/youlittleboy",
      "required": false
    },
    "FSUB_CHANNEL": {
      "description": "Channel wajib join, contoh @namachannel (opsional)",
      "required": false
    }
  }
}
