# ═══════════════════════════════════════════════════════════
#  VallTgMusic New — contoh konfigurasi
#  Salin file ini menjadi .env lalu isi nilainya:
#      cp .env.example .env
#
#  JANGAN commit file .env yang sudah terisi ke GitHub.
#  Di Heroku, isi variabel ini lewat Settings → Config Vars.
# ═══════════════════════════════════════════════════════════

# ── WAJIB ──────────────────────────────────────────────────

# API ID & API HASH dari https://my.telegram.org  (API development tools)
API_ID=
API_HASH=

# Token bot dari @BotFather
BOT_TOKEN=

# String session akun USERBOT (akun Telegram pribadi, bukan bot)
# yang akan join Voice Chat.
#
# Cara termudah: ambil dari bot https://t.me/ssgenduabot
#
# Atau buat sendiri (jalankan di komputer sendiri):
#
#   pip install telethon
#   python3 -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c = TelegramClient(StringSession(), int(input('API_ID: ')), input('API_HASH: ')); c.start(); print(c.session.save())"
#
# Masukkan nomor HP + kode login, lalu salin teks panjang yang tercetak.
# Perlakukan seperti password: siapa pun yang punya string ini bisa mengakses akun.
SESSION_STRING=

# ID Telegram Anda sendiri (owner bot). Cek lewat @userinfobot
ADMIN_ID=

# ── OPSIONAL ───────────────────────────────────────────────

# Link channel kredit Anda. Contoh: https://t.me/channelanda
CREDIT_CHANNEL=

# Channel yang wajib di-join user sebelum memakai bot.
# Contoh: @channel_wajib_join   (kosongkan = fitur nonaktif)
FSUB_CHANNEL=
